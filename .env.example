# Copy to .env.local (never commit real values) and fill in your keys.
# Neon Postgres
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

HYPARROW_API_KEY=pk_live_xxx
HYPARROW_API_SECRET=sk_live_xxx
HYPARROW_BASE_URL=https://api.hyparrow.cloud/api/v1
HYPARROW_VA_BANK_CODE=035
HYPARROW_WEBHOOK_SECRET=your-hyparrow-webhook-signing-secret

# Termii (phone OTP)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=FFFCSL
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic
TERMII_PIN_LENGTH=6
TERMII_PIN_TTL_MINUTES=10
TERMII_PIN_ATTEMPTS=3

# Cloudflare R2 object storage (passport photos)
# Create the bucket + an API token (Account > R2 > Manage API Tokens) in the
# Cloudflare dashboard first; the account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=fffcsl-photos
